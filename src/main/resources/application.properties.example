spring.application.name=gameflix-auth

spring.datasource.url=jdbc:mysql://localhost:3306/gameflix
spring.datasource.username=gameflix_app

spring.config.import=optional:classpath:application-local.properties

spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false

app.cors.allowed-origin=http://localhost:3000
app.jwt.lifetime-seconds=900

# Put these keys in your untracked application-local.properties:
# spring.datasource.password=REPLACE_WITH_DATABASE_PASSWORD
# app.jwt.secret=REPLACE_WITH_BASE64_ENCODED_RANDOM_SECRET
#
# Generate the JWT secret using:
# openssl rand -base64 32

